{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ardian.com/schemas/entitlement-management/app-declaration-v2.schema.json",
  "title": "Entitlement Management App Declaration (Format Ardian v2)",
  "description": "Schema de validation pour les fichiers YAML declaratifs de l'Entitlement Management Entra ID — Format Ardian v2",
  "type": "object",
  "required": [
    "app_name",
    "app_description",
    "access_packages"
  ],
  "additionalProperties": false,
  "properties": {
    "app_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-_]{1,62}[a-z0-9]$",
      "description": "Nom du catalogue et identifiant unique de l'application en kebab-case ou snake_case. Doit correspondre au nom du fichier (sans extension)."
    },
    "catalog_name": {
      "type": "string",
      "description": "Nom exact du catalogue Entra ID s'il differe de app_name (utilitaire de mapping Smart Discovery)."
    },
    "app_description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500,
      "description": "Description fonctionnelle du catalogue dans Entra ID."
    },
    "access_packages": {
      "type": "array",
      "minItems": 1,
      "description": "Liste des Access Packages rattaches a cette application / catalogue.",
      "items": {
        "$ref": "#/definitions/access_package"
      }
    }
  },
  "definitions": {
    "access_package": {
      "type": "object",
      "required": [
        "privilege_level",
        "env",
        "description",
        "authorization_owners",
        "resources"
      ],
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "description": "Nom explicite de l'Access Package s'il pre-existe dans Entra ID."
        },
        "context_subapp": {
          "type": "string",
          "maxLength": 100,
          "description": "Notion metier / sous-application (facultatif). Si vide ou omis, exclu du nommage de l'Access Package."
        },
        "privilege_level": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Intention metier de l'acces (ex: Read Only, User, Admin, IT Access)."
        },
        "env": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Environnement cible (ex: Dev, UAT, Prod)."
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500,
          "description": "Description fonctionnelle de l'Access Package affichee dans MyAccess."
        },
        "authorization_owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "email"
          },
          "description": "Liste des emails des approbateurs / proprietaires de l'autorisation."
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "description": "Ressources attribuees par cet Access Package.",
          "items": {
            "$ref": "#/definitions/resource"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "required": ["resource_type"],
      "properties": {
        "resource_type": {
          "type": "string",
          "enum": ["Application Role", "EntraID Group", "Sharepoint Group"],
          "description": "Type de la ressource cible."
        },
        "enterprise_app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Nom de l'Enterprise App cible dans Entra ID."
        },
        "app_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Nom exact du role dans l'App Registration."
        },
        "group_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Nom du groupe existant dans Entra ID (evalue de maniere insensible a la casse)."
        },
        "catalog_id": {
          "type": "string",
          "description": "ID du catalogue SharePoint."
        },
        "sharepoint_url": {
          "type": "string",
          "format": "uri",
          "description": "URL complete du site SharePoint."
        },
        "role": {
          "type": "string",
          "enum": ["Member", "Owner"],
          "default": "Member",
          "description": "Rôle attribué sur le groupe (Member ou Owner)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "resource_type": { "const": "Application Role" } }
          },
          "then": {
            "required": ["enterprise_app", "app_role"],
            "additionalProperties": false,
            "properties": {
              "resource_type": { "const": "Application Role" },
              "enterprise_app": { "type": "string" },
              "app_role": { "type": "string" }
            }
          }
        },
        {
          "if": {
            "properties": { "resource_type": { "const": "EntraID Group" } }
          },
          "then": {
            "required": ["group_name"],
            "additionalProperties": false,
            "properties": {
              "resource_type": { "const": "EntraID Group" },
              "group_name": { "type": "string" },
              "role": { "type": "string", "enum": ["Member", "Owner"] }
            }
          }
        },
        {
          "if": {
            "properties": { "resource_type": { "const": "Sharepoint Group" } }
          },
          "then": {
            "required": ["catalog_id", "sharepoint_url"],
            "additionalProperties": false,
            "properties": {
              "resource_type": { "const": "Sharepoint Group" },
              "catalog_id": { "type": "string" },
              "sharepoint_url": { "type": "string" },
              "group_name": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}